modules = ["nodejs-20", "bash", "nix", "python-base-3.13"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "WhatsApp Bot"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "WhatsApp Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "9Router"

[[workflows.workflow]]
name = "WhatsApp Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start-ptero.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "9Router"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'while true; do if ! curl -sf http://127.0.0.1:20128/ >/dev/null 2>&1; then 9router --host 0.0.0.0 --port 20128 --no-browser --tray >/tmp/9router.log 2>&1 & sleep 4; fi; sleep 10; done'"

[workflows.workflow.metadata]
outputType = "console"

[userenv]

[userenv.shared]
BOT_LOGGER_LEVEL = "silent"
BOT_LOG_MESSAGE = "true"
BOT_MAX_RETRIES = "3"
BOT_SESSION_NAME = "hisoka"
BOT_PREFIX = "(?:[°•π÷×¶∆£¢€¥®™+✓=|/~!?@#%^&.©^])"
BOT_ALLOWED_NO_PREFIX = "false"

[deployment]
deploymentTarget = "vm"
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 3000

[[ports]]
localPort = 20128
externalPort = 80
