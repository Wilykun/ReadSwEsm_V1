# Konfigurasi lingkungan Wily Bot.
# Simpan file ini sebagai `.env`, lalu isi nilai yang diperlukan.

# Tingkat log yang ditampilkan oleh bot.
# Pilihan yang tersedia: info, warn, error, fatal, silent.
# `silent` = hampir tidak menampilkan log library.
# `info`   = menampilkan informasi umum.
# `warn`   = menampilkan peringatan dan error.
# `error`  = hanya menampilkan error.
# `fatal`  = hanya menampilkan error fatal.
BOT_LOGGER_LEVEL=silent

# Menentukan apakah pesan masuk dicatat ke log.
# true  = mencatat semua pesan, kecuali pesan dari bot sendiri.
# false = tidak mencatat pesan masuk.
BOT_LOG_MESSAGE=true

# Jumlah maksimum percobaan menghubungkan ulang ke WhatsApp
# jika koneksi terputus.
BOT_MAX_RETRIES=3

# Nomor telepon untuk mengaktifkan mode pairing.
# Bersifat opsional. Gunakan kode negara tanpa tanda tambah (+)
# atau spasi.
# Contoh: 62xxxxxxx
BOT_NUMBER_PAIR=

# Nama sesi bot untuk menyimpan kredensial WhatsApp.
# Jika dikosongkan, nama sesi bawaan adalah `hisoka`.
BOT_SESSION_NAME=hisoka

# Prefix untuk menjalankan perintah bot.
# Bisa menggunakan satu karakter, teks, atau pola regex.
# Konfigurasi di bawah mengizinkan berbagai karakter sebagai prefix,
# seperti titik (.), tanda seru (!), tanda tanya (?), dan lainnya.
BOT_PREFIX="(?:[°•π÷×¶∆£¢€¥®™+✓=|/~!?@#%^&.©^])"

# Menentukan apakah perintah yang valid boleh dijalankan tanpa prefix.
# true  = perintah valid boleh diketik tanpa prefix.
# false = prefix wajib digunakan untuk setiap perintah.
BOT_ALLOWED_NO_PREFIX=false